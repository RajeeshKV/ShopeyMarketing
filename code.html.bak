<input class="w-full text-xs px-3.5 py-2.5 rounded-lg bg-gray-800 border border-gray-700 text-white focus:ring-2 focus:ring-blue-500 focus:outline-none" placeholder="e.g. Trendy Clothing / Electronic Store" required="" type="text"/>
</div>
<div class="sm:col-span-2 pt-2">
<button class="w-full py-3.5 bg-white text-gray-950 rounded-lg font-bold text-sm hover:bg-gray-100 transition shadow" type="submit">
